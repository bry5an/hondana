# Copy to .env in the repo root. Gitignored.
# config.load() reads this file into the environment at startup; variables
# already set in the environment win.

# Google Books API key (free, from a Google Cloud project with the Books API
# enabled), used by the `epub-catalog` stage to look up genre/description for
# EPUBs that have an ISBN. Optional — without it the stage does nothing.
GOOGLE_BOOKS_API_KEY=
