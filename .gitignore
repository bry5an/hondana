/books/
/sample_epubs/
/audiobooks/
/vocab/
*.epub
!tests/fixtures/epubs/*.epub
*.m4b
*.m4a
*.mp3
*.aax
*.aaxc

# Python and tools
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
dist/
build/

# Logs and scratch files
*.log
log.txt
list.txt

# Keys and certificates
*.pem
*.key

# Editor, OS and local tool state
.DS_Store
*.swp
.claude/settings.local.json
.claude/scheduled_tasks.lock
.impeccable/
